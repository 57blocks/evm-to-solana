# Environment Variables
# Copy this file to .env.local and fill in your actual values

# Optionally specify a custom Solana RPC endpoint, e.g. via Helius or another provider.
# If VITE_CUSTOM_RPC_URL is left blank or undefined, the app will default to the official Solana Testnet endpoint.
VITE_CUSTOM_RPC_URL=SOLANA_RPC_ENDPOINT

# Backend API base URL for Reward History feature.
# Requires the solana-backend service to be running — see backend/solana-backend/README.md
VITE_API_BASE_URL=http://localhost:3000