# HTTP server port
PORT=3000

# Prisma — SQLite database file path, resolved relative to prisma/schema.prisma
DATABASE_URL="file:./prisma/dev.db"

# Solana RPC
SOLANA_RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=
# 901=devnet, 902=testnet, 900=mainnet
CHAIN_ID=901

# Nest backend schedulers
INDEXING_CRON=*/10 * * * * *
INDEXING_RETRY_DELAY_MS=1000
INDEXING_MAX_RETRIES=3
POOL_BALANCE_MONITOR_CRON=0 */5 * * * *
REWARD_BALANCE_THRESHOLD=1000000
SOLSCAN_API_KEY=
SOLSCAN_ENDPOINT=

# init-db format: '<poolConfigPda>:<initBlock>,<poolConfigPda2>:<initBlock2>'
POOL_CONFIGS=<pool_config_pda_base58>:<create_pool_slot>

# Whether to clear existing SyncStatus + UserActivity and reinitialize
RESET_DB=false
