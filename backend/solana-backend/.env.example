# Prisma — SQLite 数据库文件路径，相对 prisma/schema.prisma 解析
DATABASE_URL="file:./prisma/dev.db"

# Solana RPC
SOLANA_RPC_URL=https://api.devnet.solana.com

# 查询脚本入参
POOL_ID=<pool_id_pubkey_base58>
USER_ADDRESS=<user_wallet_pubkey_base58>

# init-db 用：'<poolConfigPda>:<initBlock>,<poolConfigPda2>:<initBlock2>'
POOL_CONFIGS=<pool_config_pda_base58>:<create_pool_slot>

# 是否清空现有 SyncStatus + UserActivity 重新初始化
RESET_DB=false
